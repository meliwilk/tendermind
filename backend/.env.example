## Copy to .env (gitignored) and fill in to enable real LLM-backed agents.
## Without this, the extraction agent (backend/src/extraction/) falls back to
## a heuristic stub client — see llmClient.ts's createExtractionClient().

ANTHROPIC_API_KEY=

## Optional — defaults to claude-opus-5 if unset.
# EXTRACTION_MODEL=claude-opus-5

## Optional — defaults to 4000 if unset.
# PORT=4000
